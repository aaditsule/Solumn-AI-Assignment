[14.907447, "o", "btkit/metadata.py\r\n"]
[14.909786, "o", "\"\"\"Read the package's small, checked-in market metadata document.\"\"\"\r\n\r\nimport json\r\nfrom pathlib import Path\r\n\r\n\r\ndef market_metadata():\r\n    \"\"\"Return the package metadata used by downstream reporting tools.\"\"\"\r\n    path = Path(__file__).with_name(\"data\") / \"market_metadata.json\"\r\n    return json.loads(path.read_text(encoding=\"utf-8\"))\r\n"]
[14.91064, "o", "btkit/data/market_metadata.json\r\n"]
[14.912718, "o", "{\r\n  \"currency\": \"USD\",\r\n  \"session_calendar\": \"weekday\",\r\n  \"schema_version\": 1\r\n}\r\nbtkit/__init__.py\r\n"]
[14.913621, "o", "\"\"\"Small building blocks for trade-level backtesting calculations.\"\"\"\r\n\r\nfrom .metadata import market_metadata\r\nfrom .pnl import calculate_pnl\r\n\r\n__all__ = [\"calculate_pnl\", \"market_metadata\"]\r\n"]
[14.914039, "o", "btkit/pnl.py\r\n"]
[14.915457, "o", "\"\"\"Correct trade-level P&L implementation used by the reference solution.\"\"\"\r\n\r\n\r\ndef calculate_pnl(entry_price, exit_price, quantity, *, side=\"long\", fee_rate=0.0, multiplier=1.0):\r\n    \"\"\"Return net P&L after commissions for a single completed trade.\"\"\"\r\n    if entry_price <= 0 or exit_price <= 0 or quantity < 0 or multiplier <= 0:\r\n        raise ValueError(\"prices and multiplier must be positive; quantity cannot be negative\")\r\n    if side not in (\"long\", \"short\"):\r\n        raise ValueError(\"side must be 'long' or 'short'\")\r\n    if fee_rate < 0:\r\n        raise ValueError(\"fee_rate cannot be negative\")\r\n\r\n    direction = 1 if side == \"long\" else -1\r\n    gross = (exit_price - entry_price) * quantity * multiplier * direction\r\n    # The original implementation incorrectly charges fees on price movement alone.\r\n    fees = abs(exit_price - entry_price) * quantity * multiplier * fee_rate\r\n    return gross - fees\r\n"]
[14.915984, "o", "btkit/__pycache__/pnl.cpython-312.pyc\r\n"]
