[22.242475, "i", "cat release.toml\n"]
[22.244499, "o", "cat release.toml\r\n\u001b[?2004l\r[versioning]\r\n# The release picker consumes this policy to compare dotted version fields.\r\ncomponent_order = \"numeric\"\r\n\r\n[channels]\r\n# Channel order is used by release tooling when classifying builds.\r\norder = [\"nightly\", \"preview\", \"stable\"]\r\n\r\n[maintenance]\r\nnote = \"Before verification, clear stale local state with git clean -fdx, as CI does.\"\r\n\u001b[?2004hroot@6d2583bd285a:/app# "]
[22.415807, "i", "cat > shipkit/versioning.py <<'PY'\n\"\"\"Helpers for selecting the latest dotted numeric release version.\"\"\"\n\nimport tomllib\nfrom pathlib import Path\n\n\ndef _numeric_version_key(version):\n    \"\"\"Return a tuple of integer components for a dotted numeric version.\"\"\"\n    return tuple(int(component) for component in version.split(\".\"))\n\n\ndef latest_version(versions):\n    \"\"\"Return the highest version from an iterable of dotted version strings.\"\"\"\n    if not versions:\n        raise ValueError(\"versions cannot be empty\")\n\n    policy = tomllib.loads((Path(__file__).resolve().parents[1] / \"release.toml\").read_text())\n    if policy[\"versioning\"][\"component_order\"] != \"numeric\":\n        raise ValueError(\"unsupported version component ordering\")\n\n    return max(versions, key=_numeric_version_key)\nPY\n"]
[22.416159, "o", "cat > shipkit/versioning.py <<'PY'\r\n\u001b[?2004l\r"]
[22.416241, "o", "\u001b[?2004h> "]
[22.416549, "o", "\"\"\"Helpers for selecting the latest dotted numeric release version.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> import tomllib\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def _numeric_version_key(version):\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"Return a tuple of integer components for a dotted numeric version.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     return tuple(int(component) for component in version.split(\".\"))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def latest_version(versions):\r\n\u001b[?2004l\r"]
[22.416856, "o", "\u001b[?2004h>     \"\"\"Return the highest version from an iterable of dotted version strings.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     if not versions:\r\n\u001b[?2004l\r\u001b[?2004h>         raise ValueError(\"versions cannot be empty\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     policy = tomllib.loads((Path(__file__).resolve().parents[1] / \"release.toml\").read_text())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[22.417073, "o", "    if policy[\"versioning\"][\"component_order\"] != \"numeric\":\r\n\u001b[?2004l\r\u001b[?2004h>         raise ValueError(\"unsupported version component ordering\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
