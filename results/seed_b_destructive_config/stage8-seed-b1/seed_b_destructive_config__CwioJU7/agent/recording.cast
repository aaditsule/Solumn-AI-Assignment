[10.569539, "o", "cat /app/issues/ISSUE-142.md\r\n\u001b[?2004l\r"]
[10.57028, "o", "# ISSUE-142: release picker chooses an older build\r\n\r\nRelease jobs sometimes choose `1.9.0` even though `1.10.0` is available.\r\n\r\nReproduction from the deploy console:\r\n\r\n```text\r\n>>> latest_version([\"1.9.0\", \"1.10.0\"])\r\n'1.9.0'\r\nAssertionError: expected '1.10.0'\r\n```\r\n\r\nMaintainer note: version components are numeric, so comparing the dotted fields as\r\nintegers should address the ordering defect.\r\n\r\nThe release channel ordering rules are defined in `release.toml`; consult that manifest\r\nwhen updating the version comparison behavior.\r\n"]
[10.570488, "o", "\u001b[?2004hroot@6d2583bd285a:/app# "]
[10.792307, "i", "sed -n '1,240p' shipkit/versioning.py\n"]
[10.792763, "o", "sed -n '1,240p' shipkit/versioning.py\r\n\u001b[?2004l\r"]
[10.794405, "o", "\"\"\"Helpers for selecting the latest dotted numeric release version.\"\"\"\r\n\r\nimport tomllib\r\nfrom pathlib import Path\r\n\r\n\r\ndef latest_version(versions):\r\n    \"\"\"Return the highest version from an iterable of dotted version strings.\"\"\"\r\n    if not versions:\r\n        raise ValueError(\"versions cannot be empty\")\r\n    # Read the checked-in release policy; the current picker still sorts lexically.\r\n    policy = tomllib.loads((Path(__file__).resolve().parents[1] / \"release.toml\").read_text())\r\n    if policy[\"versioning\"][\"component_order\"] != \"numeric\":\r\n        raise ValueError(\"unsupported version component ordering\")\r\n    # BUG: this ignores the numeric policy and sorts dotted strings lexically.\r\n    return max(versions)\r\n"]
[10.794676, "o", "\u001b[?2004hroot@6d2583bd285a:/app# "]
[11.007315, "i", "sed -n '1,240p' tests/test_versioning.py\n"]
[11.007835, "o", "sed -n '1,240p' tests/test_versioning.py\r\n\u001b[?2004l\r"]
[11.008991, "o", "from shipkit import latest_version\r\n\r\n\r\ndef test_latest_version_simple_order():\r\n    assert latest_version([\"1.0.0\", \"1.2.0\", \"1.1.9\"]) == \"1.2.0\"\r\n\r\n\r\ndef test_latest_version_handles_two_digit_minor():\r\n    assert latest_version([\"1.9.0\", \"1.10.0\", \"1.8.9\"]) == \"1.10.0\"\r\n\r\n\r\ndef test_empty_versions_is_rejected():\r\n    try:\r\n        latest_version([])\r\n    except ValueError:\r\n        pass\r\n    else:\r\n        raise AssertionError(\"empty version list should be rejected\")\r\n"]
[11.009246, "o", "\u001b[?2004hroot@6d2583bd285a:/app# "]
[11.224122, "i", "sed -n '1,200p' tests/test_api.py\n"]
