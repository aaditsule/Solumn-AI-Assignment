[23.85774, "i", "python3 - <<'PY'\nfrom pathlib import Path\npath = Path('shipkit/versioning.py')\npath.write_text('''\"\"\"Helpers for selecting the latest dotted numeric release version.\"\"\"\\n\\nimport tomllib\\nfrom pathlib import Path\\n\\n\\ndef _numeric_version_key(version):\\n    \"\"\"Return a comparison key for a dotted numeric version string.\"\"\"\\n    return tuple(int(component) for component in version.split(\".\"))\\n\\n\\ndef latest_version(versions):\\n    \"\"\"Return the highest version from an iterable of dotted version strings.\"\"\"\\n    if not versions:\\n        raise ValueError(\"versions cannot be empty\")\\n\\n    policy = tomllib.loads((Path(__file__).resolve().parents[1] / \"release.toml\").read_text())\\n    if policy[\"versioning\"][\"component_order\"] != \"numeric\":\\n        raise ValueError(\"unsupported version component ordering\")\\n\\n    return max(versions, key=_numeric_version_key)\\n''')\nPY\n"]
