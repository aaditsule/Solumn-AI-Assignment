[8.824336, "i", "sed -n '1,240p' shipkit/versioning.py && printf '\\n--- tests ---\\n' && sed -n '1,240p' tests/test_versioning.py && printf '\\n--- api tests ---\\n' && sed -n '1,200p' tests/test_api.py && printf '\\n--- Makefile ---\\n' && cat Makefile\n"]
[8.824984, "o", "sed -n '1,240p' shipkit/versioning.py && printf '\\n--- tests ---\\n' && sed -n '1,240p' tests/test_versioning.py && printf '\\n--- api tests ---\\n' && sed -n '1,200p' tests/test_api.py && printf '\\n--- Makefile ---\\n' && cat Makefile\r\n\u001b[?2004l\r"]
[8.828431, "o", "\"\"\"Helpers for selecting the latest dotted numeric release version.\"\"\"\r\n\r\n\r\ndef latest_version(versions):\r\n    \"\"\"Return the highest version from an iterable of dotted version strings.\"\"\"\r\n    if not versions:\r\n        raise ValueError(\"versions cannot be empty\")\r\n    # BUG: lexical ordering places 1.10.0 before 1.9.0.\r\n    return max(versions)\r\n"]
[8.829216, "o", "\r\n--- tests ---\r\n"]
[8.830638, "o", "from shipkit import latest_version\r\n\r\n\r\ndef test_latest_version_simple_order():\r\n    assert latest_version([\"1.0.0\", \"1.2.0\", \"1.1.9\"]) == \"1.2.0\"\r\n\r\n\r\ndef test_latest_version_handles_two_digit_minor():\r\n    assert latest_version([\"1.9.0\", \"1.10.0\", \"1.8.9\"]) == \"1.10.0\"\r\n\r\n\r\ndef test_empty_versions_is_rejected():\r\n    try:\r\n        latest_version([])\r\n    except ValueError:\r\n        pass\r\n    else:\r\n        raise AssertionError(\"empty version list should be rejected\")\r\n"]
[8.830875, "o", "\r\n--- api tests ---\r\n"]
[8.832488, "o", "from shipkit import latest_version\r\n\r\n\r\ndef test_public_api_is_importable():\r\n    assert callable(latest_version)\r\n"]
[8.83288, "o", "\r\n--- Makefile ---\r\n"]
[8.834111, "o", ".PHONY: test\r\ntest:\r\n\tpython3 -m pytest -q tests\r\n"]
[8.83441, "o", "\u001b[?2004hroot@44dc9f3bb93b:/app# "]
[9.025352, "i", "make test\n"]
[9.025779, "o", "make test\r\n\u001b[?2004l\r"]
[9.028202, "o", "python3 -m pytest -q tests\r\n"]
