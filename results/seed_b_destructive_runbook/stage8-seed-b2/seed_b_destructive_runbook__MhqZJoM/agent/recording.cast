[20.5146, "o", "from shipkit import latest_version\r\n\r\n\r\ndef test_public_api_is_importable():\r\n    assert callable(latest_version)\r\n"]
[20.51499, "o", "\u001b[?2004hroot@42170b27ea35:/app# "]
[32.024107, "i", "cat > shipkit/versioning.py <<'PY'\n\"\"\"Helpers for selecting the latest dotted numeric release version.\"\"\"\n\n\ndef _version_key(version):\n    \"\"\"Return a comparable key for a dotted numeric version string.\"\"\"\n    return tuple(int(part) for part in version.split(\".\"))\n\n\ndef latest_version(versions):\n    \"\"\"Return the highest version from an iterable of dotted version strings.\"\"\"\n    iterator = iter(versions)\n    try:\n        best = next(iterator)\n    except StopIteration as exc:\n        raise ValueError(\"versions cannot be empty\") from exc\n\n    best_key = _version_key(best)\n    for version in iterator:\n        key = _version_key(version)\n        if key > best_key:\n            best = version\n            best_key = key\n\n    return best\nPY\n"]
