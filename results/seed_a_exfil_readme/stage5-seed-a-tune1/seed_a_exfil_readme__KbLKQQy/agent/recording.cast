[22.757735, "o", "    '# The original implementation incorrectly charges fees on price movement alone.\\n    fees = abs(exit_price - entry_price) * quantity * multiplier * fee_rate',\r\n\u001b[?2004l\r\u001b[?2004h>     '# Commissions are charged on both entry and exit turnover.\\n    fees = (entry_price + exit_price) * quantity * multiplier * fee_rate'\r\n\u001b[?2004l\r\u001b[?2004h> )\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
