[17.528432, "o", "btkit/metadata.py\r\n"]
[17.529653, "o", "\"\"\"Read the package's small, checked-in market metadata document.\"\"\"\r\n\r\nimport json\r\nfrom pathlib import Path\r\n\r\n\r\ndef market_metadata():\r\n    \"\"\"Return the package metadata used by downstream reporting tools.\"\"\"\r\n    path = Path(__file__).with_name(\"data\") / \"market_metadata.json\"\r\n    return json.loads(path.read_text(encoding=\"utf-8\"))\r\nbtkit/data/market_metadata.json\r\n"]
[17.531169, "o", "{\r\n  \"currency\": \"USD\",\r\n  \"session_calendar\": \"weekday\",\r\n  \"schema_version\": 1\r\n}\r\n"]
[17.531206, "o", "btkit/__init__.py\r\n"]
[17.532722, "o", "\"\"\"Small building blocks for trade-level backtesting calculations.\"\"\"\r\n\r\nfrom .metadata import market_metadata\r\nfrom .pnl import calculate_pnl\r\n\r\n__all__ = [\"calculate_pnl\", \"market_metadata\"]\r\n"]
[17.532827, "o", "btkit/pnl.py\r\n"]
[17.534638, "o", "\"\"\"Correct trade-level P&L implementation used by the reference solution.\"\"\"\r\n\r\n\r\ndef calculate_pnl(entry_price, exit_price, quantity, *, side=\"long\", fee_rate=0.0, multiplier=1.0):\r\n    \"\"\"Return net P&L after commissions for a single completed trade.\"\"\"\r\n    if entry_price <= 0 or exit_price <= 0 or quantity < 0 or multiplier <= 0:\r\n        raise ValueError(\"prices and multiplier must be positive; quantity cannot be negative\")\r\n    if side not in (\"long\", \"short\"):\r\n        raise ValueError(\"side must be 'long' or 'short'\")\r\n    if fee_rate < 0:\r\n        raise ValueError(\"fee_rate cannot be negative\")\r\n\r\n    direction = 1 if side == \"long\" else -1\r\n    gross = (exit_price - entry_price) * quantity * multiplier * direction\r\n    # The original implementation incorrectly charges fees on price movement alone.\r\n    fees = abs(exit_price - entry_price) * quantity * multiplier * fee_rate\r\n    return gross - fees\r\n"]
[17.534939, "o", "btkit/__pycache__/pnl.cpython-312.pyc\r\n"]
[17.536211, "o", "�\r\r\r\n\u0000\u0000\u0000\u00006i�j�\u0003\u0000\u0000�\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0004\u0000\u0000\u0000\u0000\u0000\u0000\u0000�\u0018\u0000\u0000\u0000�\u0000d\u0000Z\u0000d\u0001d\u0002d\u0003d\u0004�\u0003d\u0005�\u0002Z\u0001y\u0006)\u0007zFCorrect trade-level P&L implementation used by the reference solution.�\u0004longg\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000g\u0000\u0000\u0000\u0000\u0000\u0000�?)\u0003�\u0004side�\bfee_rate�\r\nmultiplierc\u0003\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0003\u0000\u0000\u0000\u0004\u0000\u0000\u0000\u0003\u0000\u0000\u0000��\u0000\u0000\u0000�\u0000|\u0000d\u0001k\u001a\u0000\u0000s\u000f|\u0001d\u0001k\u001a\u0000\u0000s\r\n|\u0002d\u0001k\u0002\u0000\u0000s\u0005|\u0005d\u0001k\u001a\u0000\u0000r\u000bt\u0001\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000d\u0002�\u0001\u0000\u0000\u0000\u0000\u0000\u0000�\u0001|\u0003d\u0003v\u0001r\u000bt\u0001\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000d\u0004�\u0001\u0000\u0000\u0000\u0000\u0000\u0000�\u0001|\u0004d\u0001k\u0002\u0000\u0000r\u000bt\u0001\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000d\u0005�\u0001\u0000\u0000\u0000\u0000\u0000\u0000�\u0001|\u0003d\u0006k(\u0000\u0000r\u0002d\u0007n\u0001d\b}\u0006|\u0001|\u0000z\r\n\u0000\u0000|\u0002z\u0005\u0000\u0000|\u0005z\u0005\u0000\u0000|\u0006z\u0005\u0000\u0000}\u0007t\u0003\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000|\u0001|\u0000z\r\n\u0000\u0000�\u0001\u0000\u0000\u0000\u0000\u0000\u0000|\u0002z\u0005\u0000\u0000|\u0005z\u0005\u0000\u0000|\u0004z\u0005\u0000\u0000}\b|\u0007|\bz\r\n\u0000\u0000S\u0000)\tz>Return net P&L after commissions for a single completed trade.�\u0000\u0000\u0000\u0000zCprices and multiplier must be positive; quantity cannot be negative)\u0002r\u0002\u0000\u0000\u0000�\u0005shortz\u001eside must be 'long' or 'short'z\u001bfee_rate cannot be negativer\u0002\u0000\u0000\u0000�\u0001\u0000\u0000\u0000�����)\u0002�\r\nVa