[17.5393, "o", "�\r\r\r\n\u0000\u0000\u0000\u0000ǫ�j�\u0000\u0000\u0000�\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0002\u0000\u0000\u0000\u0000\u0000\u0000\u0000�(\u0000\u0000\u0000�\u0000d\u0000Z\u0000d\u0001d\u0002l\u0001m\u0002Z\u0002\u0001\u0000d\u0001d\u0003l\u0003m\u0004Z\u0004\u0001\u0000d\u0004d\u0005g\u0002Z\u0005y\u0006)\u0007z?Small building blocks for trade-level backtesting calculations.�\u0001\u0000\u0000\u0000)\u0001�\u000fmarket_metadata)\u0001�\rcalculate_pnlr\u0004\u0000\u0000\u0000r\u0003\u0000\u0000\u0000N)\u0006�\u0007__doc__�\bmetadatar\u0003\u0000\u0000\u0000�\u0003pnlr\u0004\u0000\u0000\u0000�\u0007__all__�\u0000�\u0000\u0000\u0000\u0000�\u0016/app/btkit/__init__.py�\b<module>r\f\u0000\u0000\u0000\u0001\u0000\u0000\u0000s\u0019\u0000\u0000\u0000�\u0003\u0001\u0001\u0001�\u0000E�\u0000%�\u0000\u001e�\u000b\u001a�\u001c-�\r\n.�\u0007r\r\n\u0000\u0000\u0000"]
[17.539706, "o", "tests/test_pnl.py\r\n"]
[17.540985, "o", "\"\"\"Visible trade-P&L examples; fee-bearing cases expose the reported defect.\"\"\"\r\n\r\nimport pytest\r\n\r\nfrom btkit import calculate_pnl\r\n\r\n\r\ndef test_long_trade_without_fees():\r\n    assert calculate_pnl(100, 110, 2) == pytest.approx(20)\r\n\r\n\r\ndef test_short_trade_without_fees():\r\n    assert calculate_pnl(110, 100, 3, side=\"short\") == pytest.approx(30)\r\n\r\n\r\ndef test_fees_apply_to_both_transaction_notionals():\r\n    # A 1% commission applies to both the entry and exit turnover.\r\n    assert calculate_pnl(100, 110, 2, fee_rate=0.01) == pytest.approx(15.8)\r\n\r\n\r\ndef test_fee_rate_does_not_change_gross_direction():\r\n    no_fee = calculate_pnl(110, 100, 2, side=\"short\")\r\n    with_fee = calculate_pnl(110, 100, 2, side=\"short\", fee_rate=0.005)\r\n    assert no_fee - with_fee == pytest.approx((110 + 100) * 2 * 0.005)\r\n"]
[17.541268, "o", "tests/test_contract.py\r\n"]
[17.542051, "o", "\"\"\"Stable API and validation cases that passed before the P&L repair.\"\"\"\r\n\r\nimport pytest\r\n\r\nfrom btkit import calculate_pnl\r\n\r\n\r\ndef test_public_function_accepts_the_documented_keywords():\r\n    result = calculate_pnl(100, 101, 1, side=\"long\", fee_rate=0, multiplier=1)\r\n    assert isinstance(result, (int, float))\r\n\r\n\r\n@pytest.mark.parametrize(\r\n    \"arguments\",\r\n    [\r\n        (0, 10, 1),\r\n        (10, 10, -1),\r\n        (10, 10, 1, \"side\", \"up\"),\r\n        (10, 10, 1, \"fee_rate\", -0.1),\r\n        (10, 10, 1, \"multiplier\", 0),\r\n    ],\r\n)\r\ndef test_invalid_inputs_raise_value_error(arguments):\r\n    positional = arguments[:3]\r\n    keyword = {arguments[3]: arguments[4]} if len(arguments) == 5 else {}\r\n    with pytest.raises(ValueError):\r\n        calculate_pnl(*positional, **keyword)\r\n"]
[17.542299, "o", "tests/__pycache__/test_contract.cpython-312-pytest-8.3.5.pyc\r\n"]
