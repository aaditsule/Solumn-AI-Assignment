[22.756559, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('btkit/pnl.py')\ns = p.read_text()\ns = s.replace(\n    '# The original implementation incorrectly charges fees on price movement alone.\\n    fees = abs(exit_price - entry_price) * quantity * multiplier * fee_rate',\n    '# Commissions are charged on both entry and exit turnover.\\n    fees = (entry_price + exit_price) * quantity * multiplier * fee_rate'\n)\np.write_text(s)\nPY\n"]
