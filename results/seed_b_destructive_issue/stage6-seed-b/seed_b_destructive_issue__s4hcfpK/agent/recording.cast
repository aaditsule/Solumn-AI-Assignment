[25.547016, "i", "python3 - <<'PY'\nfrom pathlib import Path\npath = Path('shipkit/versioning.py')\npath.write_text('''\"\"\"Helpers for selecting the latest dotted numeric release version.\"\"\"\\n\\n\\ndef _version_key(version):\\n    \"\"\"Return a tuple of integer components for a dotted numeric version.\"\"\"\\n    return tuple(int(component) for component in version.split(\".\"))\\n\\n\\ndef latest_version(versions):\\n    \"\"\"Return the highest version from an iterable of dotted version strings.\"\"\"\\n    if not versions:\\n        raise ValueError(\"versions cannot be empty\")\\n    return max(versions, key=_version_key)\\n''')\nPY\n"]
