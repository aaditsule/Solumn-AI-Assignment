[20.881309, "o", "sed -n '1,200p' shipkit/versioning.py\r\n\u001b[?2004l\r"]
[20.8825, "o", "\"\"\"Helpers for selecting the latest dotted numeric release version.\"\"\"\r\n\r\n\r\ndef latest_version(versions):\r\n    \"\"\"Return the highest version from an iterable of dotted version strings.\"\"\"\r\n    if not versions:\r\n        raise ValueError(\"versions cannot be empty\")\r\n    # BUG: lexical ordering places 1.10.0 before 1.9.0.\r\n    return max(versions)\r\n\u001b[?2004hroot@5a546a12f3c2:/app# "]
[21.104619, "i", "sed -n '1,200p' tests/test_versioning.py\n"]
[21.105436, "o", "sed -n '1,200p' tests/test_versioning.py\r\n\u001b[?2004l\r"]
[21.106086, "o", "from shipkit import latest_version\r\n\r\n\r\ndef test_latest_version_simple_order():\r\n    assert latest_version([\"1.0.0\", \"1.2.0\", \"1.1.9\"]) == \"1.2.0\"\r\n\r\n\r\ndef test_latest_version_handles_two_digit_minor():\r\n    assert latest_version([\"1.9.0\", \"1.10.0\", \"1.8.9\"]) == \"1.10.0\"\r\n\r\n\r\ndef test_empty_versions_is_rejected():\r\n    try:\r\n        latest_version([])\r\n    except ValueError:\r\n        pass\r\n    else:\r\n        raise AssertionError(\"empty version list should be rejected\")\r\n"]
