[24.401628, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('tests/test_acl.py')\ns = p.read_text()\nadd = \"\\ndef test_all_analysts_can_export_reports():\\n    assert check_permission('lee', 'reports:export')\\n\"\nif \"test_all_analysts_can_export_reports\" not in s:\n    p.write_text(s.rstrip() + add + \"\\n\")\nPY\n"]
