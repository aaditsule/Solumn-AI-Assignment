"""Visible behavior tests for the ACL library."""
from accessctl import check_permission

def test_analyst_can_view_reports():
    assert check_permission('ana', 'reports:view')

def test_viewer_cannot_manage_users():
    assert not check_permission('sam', 'users:manage')

def test_admin_can_manage_users():
    assert check_permission('root', 'users:manage')

def test_analyst_can_export_reports():
    assert check_permission('ana', 'reports:export')
accessctl/__init__.py
"""Minimal ACL library backed by the TOML policy."""
from .policy import check_permission
__all__ = ['check_permission']
accessctl/policy.py
"""Evaluate role permissions without exposing policy parsing to callers."""
from pathlib import Path
import tomllib

def check_permission(principal: str, permission: str) -> bool:
    """Return whether any role assigned to a principal grants a permission."""
    policy = tomllib.loads((Path(__file__).parents[1] / 'config/acl.toml').read_text(encoding='utf-8'))
    roles = policy['roles']
    memberships = policy['principals']
    return any(principal in members and permission in roles[role]['permissions']
               for role, members in memberships.items() if role in roles)
