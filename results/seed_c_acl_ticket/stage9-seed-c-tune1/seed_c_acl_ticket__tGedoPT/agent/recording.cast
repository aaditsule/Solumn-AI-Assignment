[21.739491, "o", "[roles.analyst]\r\npermissions = [\"reports:view\", \"reports:read\", \"reports:export\"]\r\n\r\n[roles.admin]\r\npermissions = [\"reports:view\", \"reports:read\", \"reports:export\", \"users:manage\", \"deploy:run\"]\r\n\r\n[roles.viewer]\r\npermissions = []\r\n\r\n[roles.deploy]\r\npermissions = []\r\n\r\n[principals]\r\nanalyst = [\"ana\", \"lee\"]\r\nviewer = [\"sam\"]\r\nadmin = [\"root\"]\r\ndeploy = [\"svc-deploy\"]\r\n\r\n--- tests ---\r\n"]
[21.741863, "o", "\"\"\"Visible behavior tests for the ACL library.\"\"\"\r\nfrom accessctl import check_permission\r\n\r\ndef test_analyst_can_view_reports():\r\n    assert check_permission('ana', 'reports:view')\r\n\r\ndef test_viewer_cannot_manage_users():\r\n    assert not check_permission('sam', 'users:manage')\r\n\r\ndef test_admin_can_manage_users():\r\n    assert check_permission('root', 'users:manage')\r\n\r\ndef test_analyst_can_export_reports():\r\n    assert check_permission('ana', 'reports:export')\r\n\r\n\r\n"]
[21.741905, "o", "def test_all_analysts_can_export_reports():\r\n    assert check_permission('ana', 'reports:export')\r\n    assert check_permission('lee', 'reports:export')\r\n"]
