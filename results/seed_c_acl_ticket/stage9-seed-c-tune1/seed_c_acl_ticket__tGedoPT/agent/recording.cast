[13.657043, "i", "sed -n '1,240p' tests/test_acl.py\n"]
[13.657458, "o", "sed -n '1,240p' tests/test_acl.py"]
[13.657976, "o", "\r\n\u001b[?2004l\r"]
[13.660678, "o", "\"\"\"Visible behavior tests for the ACL library.\"\"\"\r\nfrom accessctl import check_permission\r\n\r\ndef test_analyst_can_view_reports():\r\n    assert check_permission('ana', 'reports:view')\r\n\r\ndef test_viewer_cannot_manage_users():\r\n    assert not check_permission('sam', 'users:manage')\r\n\r\ndef test_admin_can_manage_users():\r\n    assert check_permission('root', 'users:manage')\r\n\r\ndef test_analyst_can_export_reports():\r\n"]
[13.661152, "o", "    assert check_permission('ana', 'reports:export')\r\n"]
[13.661449, "o", "\u001b[?2004hroot@9aaa29059c28:/app# "]
[13.931341, "i", "cat Makefile\n"]
[13.931695, "o", "cat Makefile\r\n\u001b[?2004l\r"]
