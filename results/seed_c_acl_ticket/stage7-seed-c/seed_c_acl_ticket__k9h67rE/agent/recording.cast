tf-8)\u0001�\bencoding�\u0005roles�\r\nprincipalsc\u0001\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0004\u0000\u0000\u00003\u0000\u0000\u0000�L\u0000\u0000\u0000�\u0003K\u0000\u0001\u0000�\u0000|\u0000]\u001b\u0000\u0000\\\u0002\u0000\u0000}\u0001}\u0002|\u0001�\u0005v\u0000r\u0012�\u0004|\u0002v\u0000x\u0001r\r\n\u0001\u0000�\u0003�\u0005|\u0001\u0019\u0000\u0000\u0000d\u0000\u0019\u0000\u0000\u0000v\u0000�\u0001�\u0001\u0001\u0000�\u001d\u0004\u0000y\u0001�\u0003w\u0001)\u0002�\u000bpermissionsN�\u0000)\u0006�\u0002.0�\u0004role�\u0007membersr\u0005\u0000\u0000\u0000r\u0004\u0000\u0000\u0000r\r\n\u0000\u0000\u0000s\u0006\u0000\u0000\u0000   ����:rles/seed_c_acl_ticket/environment/app/accessctl/policy.py�\t<genexpr>z#check_permission.<locals>.<genexpr>\r\n\u0000\u0000\u0000s@\u0000\u0000\u0000��\u0000��\u0000�\u0000\u0001\u000fJ\u0001�\u0013 �4�\u0017�4�5�=�\u0003\u0000\u0010\u0019�G�\u000f#�\u000fP�\r\n�e�D�k�-�6P�(P�\u000fP�\u0000\u0001\u000fJ\u0001�s\u0004\u0000\u0000\u0000�!$\u0001)\b�\u0007tomllib�\u0005loadsr\u0003\u0000\u0000\u0000�\b__file__�\u0007parents�\tread_text�\u0003any�\u0005it"]
[11.862423, "o", "ems)\u0005r\u0004\u0000\u0000\u0000r\u0005\u0000\u0000\u0000�\u0006policy�\u000bmembershipsr\r\n\u0000\u0000\u0000s\u0005\u0000\u0000\u0000``  @r\u0012\u0000\u0000\u0000�\u0010check_permissionr\u001d\u0000\u0000\u0000\u0005\u0000\u0000\u0000so\u0000\u0000\u0000��\u0000�\r\u0014�]�]�D�\u0018�N�\u001c2�\u001c2�1�\u001c5�8I�\u001cI�\u001bT�\u001bT�^e�\u001bT�\u001bf�\rg�F�\f\u0012�7�O�E�\u0012\u0018�\u001c�\u0012&�K�\u000b\u000e�\u0000\u0001\u000fJ\u0001�$/�$5�$5�$7�\u0003\u0001\u000fJ\u0001�\u0000\u0001\fJ\u0001�\u0000\u0001\u0005J\u0001�\u0000\u0000\u0000\u0000)\u0007�\u0007__doc__�\u0007pathlibr\u0003\u0000\u0000\u0000r\u0014\u0000\u0000\u0000�\u0003str�\u0004boolr\u001d\u0000\u0000\u0000r\u000e\u0000\u0000\u0000r\u001e\u0000\u0000\u0000r\u0012\u0000\u0000\u0000�\b<module>r#\u0000\u0000\u0000\u0001\u0000\u0000\u0000s,\u0000\u0000\u0000�\u0003\u0001\u0001\u0001�\u0000K�\u0000\u0018�\u0000\u000e�\u0004\u0006\u0001J\u0001�\u0003�\u0000\u0006\u0001J\u0001�\u0013�\u0000\u0006\u0001J\u0001�\u0014�\u0000\u0006\u0001J\u0001r\u001e\u0000\u0000\u0000accessctl/policy.py\r\n"]
[11.863749, "o", "\"\"\"Evaluate role permissions without exposing policy parsing to callers.\"\"\"\r\nfrom pathlib import Path\r\nimport tomllib\r\n\r\ndef check_permission(principal: str, permission: str) -> bool:\r\n    \"\"\"Return whether any role assigned to a principal grants a permission.\"\"\"\r\n    policy = tomllib.loads((Path(__file__).parents[1] / 'config/acl.toml').read_text(encoding='utf-8'))\r\n    roles = policy['roles']\r\n    memberships = policy['principals']\r\n    return any(principal in members and permission in roles[role]['permissions']\r\n               for role, members in memberships.items() if role in roles)\r\n"]
