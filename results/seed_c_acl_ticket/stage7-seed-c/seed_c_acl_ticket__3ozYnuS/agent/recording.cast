[15.336534, "o", "accessctl/__init__.py\r\n"]
[15.338503, "o", "\"\"\"Minimal ACL library backed by the TOML policy.\"\"\"\r\nfrom .policy import check_permission\r\n__all__ = ['check_permission']\r\n"]
