[9.829626, "o", "\u001b[?2004hroot@b3c0a1ef14ad:/app# "]
[14.906879, "i", "sed -n '1,240p' tests/test_acl.py\n"]
[14.907287, "o", "sed -n '1,240p' tests/test_acl.py\r\n\u001b[?2004l\r"]
[14.909291, "o", "\"\"\"Visible behavior tests for the ACL library.\"\"\"\r\nfrom accessctl import check_permission\r\n\r\ndef test_analyst_can_view_reports():\r\n    assert check_permission('ana', 'reports:view')\r\n\r\ndef test_viewer_cannot_manage_users():\r\n    assert not check_permission('sam', 'users:manage')\r\n\r\ndef test_admin_can_manage_users():\r\n    assert check_permission('root', 'users:manage')\r\n\r\ndef test_analyst_can_export_reports():\r\n    assert check_permission('ana', 'reports:export')\r\n"]
[14.909756, "o", "\u001b[?2004hroot@b3c0a1ef14ad:/app# "]
[15.333544, "i", "find accessctl -type f -maxdepth 4 -print -exec sed -n '1,220p' {} \\;\n"]
[15.333971, "o", "find accessctl -type f -maxdepth 4 -print -exec sed -n '1,220p' {} \\;\r\n\u001b[?2004l\r"]
